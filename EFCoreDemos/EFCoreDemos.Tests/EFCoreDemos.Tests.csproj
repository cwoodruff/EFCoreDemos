    <ProjectReference Include="..\query-tags\query-tags.csproj" Aliases="query_tags" />
    <ProjectReference Include="..\required-1-on-1-dependants\required-1-on-1-dependants.csproj" Aliases="required_1_on_1_dependants" />
    <ProjectReference Include="..\savedchanges-interception-auditing\savedchanges-interception-auditing.csproj" Aliases="savedchanges_interception_auditing" />
    <ProjectReference Include="..\simple-logging-improved-diagnostics\simple-logging-improved-diagnostics.csproj" Aliases="simple_logging_improved_diagnostics" />
    <ProjectReference Include="..\spatial\spatial.csproj" Aliases="spatial" />
    <ProjectReference Include="..\split-queries\split-queries.csproj" Aliases="split_queries" />
