    <ProjectReference Include="..\from_sql\from_sql.csproj" Aliases="from_sql" />
    <ProjectReference Include="..\identity-resolution\identity-resolution.csproj" Aliases="identity_resolution" />
    <ProjectReference Include="..\interception-db-ops\interception-db-ops.csproj" Aliases="interception_db_ops" />
    <ProjectReference Include="..\json-columns\json-columns.csproj" Aliases="json_columns" />
    <ProjectReference Include="..\keyless-entity-types\keyless-entity-types.csproj" Aliases="keyless_entity_types" />
    <ProjectReference Include="..\lazy-loading\lazy-loading.csproj" Aliases="lazy_loading" />
